    {
      "id": "S6",
      "what": "收尾：停后端与预览，确认无监听",
      "command": "Stop-Process 55164,54680,54460；Get-NetTCPConnection -State Listen -LocalPort 8501,8502,8600,8610,5173",
      "observed": {"listeners": {}, "env_stack": "ACTIVE_ANALYSIS_UI=legacy"},
      "assertion": "五个端口均无监听，默认入口回到 legacy",
      "passed": true
