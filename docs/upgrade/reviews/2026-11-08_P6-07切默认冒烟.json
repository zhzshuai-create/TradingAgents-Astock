    {
      "id": "S4",
      "what": "立即回退 .env.stack 到 legacy（后端在跑，由 set 重启）",
      "command": ".venv/Scripts/python.exe scripts/stack_mode.py set legacy",
      "output": "written .env.stack: ACTIVE_ANALYSIS_UI=legacy；[warn] 8501 未监听：legacy 下没有入口能发起分析；backend restarted: /api/v1/meta/options write_mode=legacy",
      "assertion": "重启后 8600 自报 write_mode=legacy；8501 未起属预期（本机不常驻旧版）",
      "passed": true
    },
    {
      "id": "S5",
      "what": "回退后的写入判据",
      "command": "GET /api/v1/meta/options；POST /api/v1/jobs（新幂等键、600519、2026-11-08、独立配置）",
      "observed": {"meta_write_mode": "legacy", "contract_version": "api-v1", "post_status": 409, "error_code": "write_mode_legacy", "jobs_total_before": 10, "jobs_total_after": 10},
      "assertion": "legacy 下新键被 409 write_mode_legacy 拒绝，且没有新增任务行",
      "passed": true
