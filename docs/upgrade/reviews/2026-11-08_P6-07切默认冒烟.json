    {
      "id": "S2",
      "what": "起前端预览（后端不托管 SPA）",
      "command": "cd frontend && node node_modules/vite/bin/vite.js preview --port 5173 --strictPort",
      "observed": {"listen": "[::1]:5173", "pid": 54460, "backend_root": "GET http://127.0.0.1:8600/ -> 404（后端只提供 api）", "proxy": "GET http://localhost:5173/api/v1/meta/options -> 200 application/json"},
      "assertion": "preview 的 /api 代理指向 8600，写入口读取与后端一致",
      "passed": true
    },
    {
      "id": "S3",
      "what": "浏览器冒烟（只读，不建真实任务）",
