      "new_job_created": false,
      "screenshots": [
        "docs/upgrade/reviews/p6_07_switch_shots/settings.png",
        "docs/upgrade/reviews/p6_07_switch_shots/jobs.png",
        "docs/upgrade/reviews/p6_07_switch_shots/reports.png"
      ],
      "assertion": "设置页写入者显示「新版入口」，任务/报告列表可读，控制台 0 error、0 失败请求",
      "passed": true
