        "jobs": {"rows": 10, "cards": 10, "empty": false, "loading": false},
        "reports": {"rows": 7, "cards": 7, "empty": false, "loading": false},
        "console_errors": [],
        "page_errors": [],
        "failed_requests": [],
        "elapsed_s": 3.2
