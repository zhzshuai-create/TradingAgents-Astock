# LLM Providers (set the one you use)
# NVIDIA NIM — 免费！https://build.nvidia.com → API Keys → nvapi-xxx
NVIDIA_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=
# 小米 MiMo — https://console.xiaomimimo.com → API Keys
MIMO_API_KEY=

# 第三方中转 / 代理网关地址（可选）。设置后所有模型请求走此地址，
# 方便国内通过中转访问 Claude / OpenAI 等。Web UI 侧边栏也可直接填写。
# 例: BACKEND_URL=https://your-proxy.com/v1
BACKEND_URL=

# 提速选项（可选）
# MiMo 推理强度：low / medium / high。low 单次调用快约 30-40%，质量略降。默认 low。
MIMO_REASONING_EFFORT=low
# 分析师并行：1=并发执行（墙钟时间约为最慢分析师），0=串行。
# 并行会同时发起多个 LLM 请求，可能触发服务商限流(429)。默认 0。
TA_PARALLEL_ANALYSTS=0
